{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "father",
  "main": "worker.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "majlis-game",
      "database_id": "fdfa8589-5fc4-4956-9307-d804820f92d6"
    }
  ]
}
