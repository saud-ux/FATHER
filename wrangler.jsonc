{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "majlis-hex-game",
  "main": "worker.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "majlis-game",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "majlis-game-images"
    }
  ]
}
