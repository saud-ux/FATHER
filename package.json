{
  "name": "majlis-hex-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --experimental-strip-types --test test-core.ts && node --experimental-strip-types test-api.mjs && node --experimental-strip-types test-images.mjs",
    "db:local": "wrangler d1 execute DB --local --file=schema.sql",
    "db:remote": "wrangler d1 execute DB --remote --file=schema.sql"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "wrangler": "4.92.0"
  }
}
